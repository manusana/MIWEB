---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/manuel-sanchez.jpg';
import { profile, projects } from '../data/site';

const technologies = [
  { name: 'Astro', tag: 'LA BASE', description: 'Webs centradas en el contenido, con el JavaScript justo para cada interacción.', symbol: 'A', className: 'astro' },
  { name: 'TypeScript', tag: 'EL CÓDIGO', description: 'Código ordenado y comprobaciones que ayudan a detectar errores al desarrollar.', symbol: 'TS', className: 'typescript' },
  { name: 'Tailwind CSS', tag: 'EL DISEÑO', description: 'Interfaces coherentes y adaptadas a distintas pantallas.', symbol: '≈', className: 'tailwind' },
  { name: 'Git & GitHub', tag: 'EL PROCESO', description: 'Control de versiones para seguir los cambios y la evolución de cada proyecto.', symbol: '↗', className: 'git' },
];
const process = [
  { title: 'Primero, entender el negocio.', subtitle: 'Qué haces, a quién te diriges y qué necesitas.', description: 'Hablamos de tus servicios, tus clientes y lo que quieres conseguir con la web. Si ya tienes una, reviso su contenido, su funcionamiento en móvil y qué está dificultando que la gente encuentre lo que busca. Acordamos el alcance y los plazos antes de empezar.', tags: ['Análisis de la web actual', 'Objetivos y alcance'] },
  { title: 'Ordenar y diseñar.', subtitle: 'Una estructura clara y una identidad propia.', description: 'Defino las secciones y organizo los textos, las imágenes y las formas de contacto. Preparo una propuesta visual que encaje con tu negocio y la revisamos juntos antes de pasar al desarrollo.', tags: ['Contenido', 'Diseño a medida'] },
  { title: 'Construir con cuidado.', subtitle: 'Móvil, velocidad y accesibilidad desde el inicio.', description: 'Desarrollo la web con Astro y adapto el diseño a móvil, tablet y escritorio. Optimizo las imágenes, cuido la navegación con teclado y añado movimiento donde mejora la experiencia. Preparo también títulos y descripciones para los buscadores.', tags: ['Desarrollo responsive', 'Rendimiento'] },
  { title: 'Revisar y publicar.', subtitle: 'Comprobar los detalles antes de dar el paso.', description: 'Revisamos el contenido, los enlaces, el contacto y el comportamiento en distintos tamaños de pantalla. Si sustituimos una web existente, planificamos el cambio y las redirecciones de las páginas necesarias. Dejamos acordados el dominio, el alojamiento y cómo se gestionarán las futuras actualizaciones.', tags: ['Pruebas y lanzamiento', 'Entrega y mantenimiento'] },
];
---
<Layout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="header" id="inicio">
    <div class="container header-inner">
      <a class="brand" href="#inicio" aria-label="Manuel Sanchez, inicio"><span class="brand-symbol" aria-hidden="true">ms.</span><span>{profile.name}</span><span class="brand-dot" aria-hidden="true">✳</span></a>
      <button class="menu-toggle" aria-label="Abrir menú" aria-controls="navigation" aria-expanded="false"><span></span><span></span></button>
      <nav id="navigation" aria-label="Navegación principal">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#desarrollo-web">Desarrollo web</a>
        <a class="nav-contact" href="#contacto">Hablemos <Icon /></a>
      </nav>
    </div>
  </header>
  <main id="contenido">
    <section class="about-section" id="sobre-mi" aria-labelledby="about-title">
      <div class="container section">
        <span class="section-label light-label" data-reveal><span>01 /</span> SOBRE MÍ</span>
        <div class="about-grid">
          <div class="about-heading" data-reveal>
            <h1 id="about-title">La persona<br />detrás del<br />código<span class="lime">.</span></h1>
            <div class="signature-line"><Image class="profile-photo" src={portrait} alt="Foto de Manuel Sanchez" width={160} height={160} widths={[80, 160, 240]} sizes="80px" fit="cover" position="center" format="webp" quality={85} loading="eager" fetchpriority="high" decoding="async" /><div><strong>{profile.name}</strong><span>Estudiante de Ingeniería Informática.</span></div><Icon name="code" /></div>
          </div>
          <div class="about-copy" data-reveal>
            <p class="large-copy">Estoy aprendiendo a construir software.<br /><span>Y quiero hacerlo construyendo cosas que importen.</span></p>
            <p>Estudio segundo de Ingeniería Informática. Me gusta llevar lo que aprendo a la práctica: plantear una idea, entender cómo resolverla y darle forma con código.</p>
            <p>Me interesa especialmente la unión entre diseño y tecnología. Que una web se vea bien, funcione con fluidez y tenga sentido para la persona que la utiliza.</p>
            <p>En este portfolio iré compartiendo mis proyectos y mi evolución. Una de las formas en las que quiero aplicar lo que sé es ayudando a pequeños negocios a crear o renovar su presencia en internet.</p>
            <div class="education"><span class="education-icon"><Icon name="code" /></span><div><span>ACTUALMENTE ESTUDIANDO</span><strong>{profile.education}</strong></div></div>
          </div>
        </div>
        <div class="tech-section" id="tecnologias">
          <div class="tech-heading" data-reveal><span class="section-label light-label">HERRAMIENTAS QUE UTILIZO</span><p>Mi base para desarrollar webs.</p></div>
          <div class="tech-grid">{technologies.map((tech) => <article class="tech-card" data-reveal><div class="tech-top"><span class:list={['tech-symbol', tech.className]} aria-hidden="true">{tech.symbol}</span><span>{tech.tag}</span></div><h3>{tech.name}</h3><p>{tech.description}</p></article>)}</div>
        </div>
      </div>
    </section>

    <section class="section projects-section" id="proyectos" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-heading" data-reveal><div><span class="section-label"><span>02 /</span> PROYECTOS</span><h2 id="projects-title">Lo que voy<br /><span class="muted">construyendo.</span></h2></div><p>Mis ideas llevadas a la práctica.<br />Un espacio que crecerá con cada proyecto.</p></div>
        <div class="project-grid">
          <article class="project-card" data-reveal>
            <a href="#inicio" class="project-cover portfolio-cover" aria-label="Ver mi portfolio: volver al inicio"><div class="cover-top"><span>PROYECTO PERSONAL</span><Icon /></div><div class="cover-brand">Manuel<br />Sanchez<span>✳</span></div><div class="cover-bottom"><span>Mi espacio en internet.</span><span class="cover-pill">ASTRO + TYPESCRIPT</span></div></a>
            <div class="project-caption"><div><h3>Mi portfolio personal</h3><p>Diseño, desarrollo e identidad propia.</p></div><span class="project-year">2026</span></div>
            <details class="project-details"><summary>Sobre este proyecto <Icon name="plus" /></summary><p>Una web de una sola página para presentarme, compartir mis proyectos y explicar mi forma de trabajar. Desarrollada con Astro, TypeScript y Tailwind CSS, con imágenes optimizadas, navegación por secciones y movimiento adaptado a las preferencias de cada persona.</p></details>
          </article>
          {projects.map((project) => <article class="project-card added-project" data-reveal><a class="project-cover custom-cover" href={project.url} target="_blank" rel="noopener noreferrer"><div class="cover-top"><span>{project.category}</span><Icon /></div><h3>{project.name}</h3><span>Visitar el proyecto ↗</span></a><div class="project-caption"><div><h3>{project.name}</h3><p>{project.description}</p></div></div></article>)}
          <article class="project-card next-project" data-reveal>
            <a class="project-cover next-cover" href="#desarrollo-web"><div class="cover-top"><span>ABIERTO A COLABORACIONES</span><Icon /></div><div class="next-title">Tu próxima<br /><span>web.</span></div><div class="cover-bottom"><span>Conoce cómo puedo ayudarte.</span><span class="next-plus" aria-hidden="true">+</span></div></a>
            <div class="project-caption"><div><h3>¿Construimos algo juntos?</h3><p>Desarrollo web para pequeños negocios.</p></div></div>
          </article>
        </div>
      </div>
    </section>

    <section class="section container web-section" id="desarrollo-web" aria-labelledby="services-title">
      <div class="services">
        <div class="section-intro" data-reveal>
          <span class="section-label"><span>03 /</span> DESARROLLO WEB</span>
          <h2 id="services-title">Una primera web.<br /><span class="muted">O un nuevo<br />comienzo.</span></h2>
          <p>Ayudo a pequeños negocios que todavía no tienen web o cuya página se ha quedado anticuada. Diseño y desarrollo un espacio que explique bien lo que hacen y facilite que sus clientes contacten.</p>
          <p>Trabajo directamente contigo, desde la primera conversación hasta la publicación. Así es el proceso:</p>
          <a class="text-link" href="#contacto">Hablemos de tu web <Icon /></a>
        </div>
        <div class="service-list">{process.map((step, index) => <details class="service" open={index === 0} data-reveal><summary><span class="service-number">0{index + 1}</span><div><h3>{step.title}</h3><span>{step.subtitle}</span></div><Icon name="plus" /></summary><div class="service-body"><p>{step.description}</p><div class="tags">{step.tags.map(tag => <span>{tag}</span>)}</div></div></details>)}</div>
      </div>
      <div class="launch-offer" id="primeros-proyectos" data-reveal>
        <div class="offer-main"><span class="offer-label"><span></span> PRIMERAS COLABORACIONES</span><h3>Tu negocio, bien contado.<br />También en internet.</h3><p>Busco mis primeros proyectos con empresas sin web o con una página que necesite renovarse. En estas primeras colaboraciones, ofrezco el diseño y el desarrollo sin coste a cambio de una reseña honesta sobre la experiencia.</p><a class="button button-lime" href="#contacto">Cuéntame tu proyecto <Icon name="arrow" /></a></div>
        <div class="offer-aside"><span class="offer-asterisk" aria-hidden="true">✳</span><ul><li><Icon name="check" /> Una estructura pensada para tus clientes</li><li><Icon name="check" /> Diseño adaptado a móvil y escritorio</li><li><Icon name="check" /> Revisión conjunta antes de publicar</li></ul><p>Antes de empezar, acordamos qué incluye el proyecto, los plazos y los posibles costes de dominio, alojamiento y mantenimiento.</p></div>
      </div>
    </section>

    <section class="contact-section" id="contacto" aria-labelledby="contact-title">
      <div class="container contact-inner" data-reveal><span class="section-label"><span>04 /</span> CONTACTO</span><div class="contact-heading"><h2 id="contact-title">¿Tienes una idea?<br /><span class="blue">Hablemos.</span></h2><span class="contact-arrow" aria-hidden="true">↗</span></div>
        {profile.email ? <div class="contact-bottom"><p>Para una web, una colaboración o compartir ideas.<br />Me encantará conocer tu proyecto.</p><a class="button button-dark" href={'mailto:' + profile.email}>{profile.email}<Icon /></a></div> : <div class="contact-bottom"><p>Pronto añadiré mi correo de contacto.<br />Aquí podrás escribirme sobre proyectos y colaboraciones.</p><span class="contact-pending"><span class="status-dot"></span> Correo disponible próximamente</span></div>}
      </div>
    </section>
  </main>
  <footer class="footer container">
    <div class="footer-top"><a class="brand" href="#inicio"><span class="brand-symbol" aria-hidden="true">ms.</span><span>{profile.name}</span></a><p>Un portfolio en constante evolución.</p><a class="text-link" href="#inicio">Volver arriba <Icon /></a></div>
    <div class="footer-wordmark" aria-hidden="true">Manuel Sanchez<span>✳</span></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.name}</span><span>Diseñado con cuidado. Construido con Astro.</span></div>
  </footer>
  <script>import '../scripts/interactions';</script>
</Layout>
