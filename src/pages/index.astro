---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import ActionMark from '../components/ActionMark.astro';
import EditorProfile from '../components/EditorProfile.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { projects, process, toolkit } from '../data/site';
const reviews = projects.filter(project => project.review);
---
<Layout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="header" id="inicio">
    <div class="container header-inner">
      <a class="brand" href="#inicio" aria-label="Manuel Sanchez, inicio"><span class="brand-code" aria-hidden="true">&lt;/&gt;</span> manuel sanchez<span aria-hidden="true">_</span></a>
      <button class="menu-toggle" aria-label="Abrir menú" aria-controls="navigation" aria-expanded="false"><span class="menu-label">Menú</span><span class="menu-bars" aria-hidden="true"><span></span><span></span></span></button>
      <nav id="navigation" aria-label="Navegación principal">
        <a href="#sobre-mi">Sobre mí</a><a href="#proyectos">Proyectos</a><a href="#desarrollo-web">Cómo trabajo</a><a href="#herramientas">Herramientas</a><a href="#contacto">Contacto</a>
      </nav>
    </div>
  </header>
  <main id="contenido">
    <section class="intro" id="sobre-mi" aria-labelledby="intro-title">
      <div class="container">
        <div class="intro-top"><span class="eyebrow">DISEÑO Y DESARROLLO WEB INDEPENDIENTE</span><span class="availability"><span></span> Abierto a primeras colaboraciones</span></div>
        <div class="intro-grid">
          <div class="intro-heading">
            <p class="hero-command" aria-hidden="true"><span>~/manuel</span> $ crear tu-próxima-web</p>
            <h1 id="intro-title">Tu negocio.<br />Una web<br /><span class="type-line"><span class="sr-only">a su altura.</span><span aria-hidden="true" data-typewriter>a su altura.</span></span></h1>
            <p class="hero-description">Diseño y desarrollo webs para pequeños negocios que necesitan verse profesionales, explicar mejor lo que hacen y conseguir más contactos.</p>
            <div class="hero-actions"><a class="button button-accent" href="#proyectos">Ver proyectos <ActionMark symbol="01" /></a></div>
            <p class="hero-start">Cuéntame tu idea. Empezamos por lo que necesita tu negocio.</p>
          </div>
          <EditorProfile />
        </div>
        <div class="intro-bottom"><span>DE LA PRIMERA IDEA A TU PROPIA WEB</span><a href="#desarrollo-web">Descubre el proceso <ActionMark symbol="··" /></a></div>
      </div>
    </section>

    <section class="section projects-section" id="proyectos" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-top" data-reveal><span class="eyebrow">01 / PROYECTOS</span><span class="section-note">Ideas que ya tienen forma.</span></div>
        <div class="section-heading" data-reveal><h2 id="projects-title">Hecho con <span class="heading-accent">criterio.</span></h2><p>Webs con identidad propia.<br />Proyectos que ya puedes explorar.</p></div>
        <div class="project-grid">
          {projects.map(project=><article class="project-card" data-reveal>
            <a class:list={['project-visual', { 'project-screenshot': project.preview }]} href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}: abrir proyecto en una pestaña nueva`}>
              {project.preview ? <Image src={project.preview} alt={project.previewAlt ?? `Vista previa de ${project.name}`} widths={[480, 800, 1200]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1000px) calc((100vw - 96px) / 2), (max-width: 1392px) calc((100vw - 164px) / 2), 614px" format="webp" quality={85} loading="lazy" decoding="async" /> : project.portfolioPreview ? <div class="site-miniature" aria-hidden="true"><div class="mini-nav"><span>manuel sanchez.</span><span>index.astro</span></div><div class="mini-content"><span class="mini-label">DISEÑO + DESARROLLO</span><strong>Tu negocio.<br />Una web<br /><em>a su altura.</em></strong><span class="mini-orbit">&lt;/&gt;</span></div><div class="mini-bottom"><span>CON NOMBRE PROPIO.</span><span>2026</span></div></div> : <span class="project-placeholder">{project.name}<Icon /></span>}
              <span class="project-open"><Icon name="window" /><span>Abrir</span></span>
            </a>
            <div class="project-meta"><span class="small-label">{project.category}</span>{project.year && <span>{project.year}</span>}</div>
            <h3>{project.name}</h3><p>{project.description}</p><dl class="project-case"><div><dt>El punto de partida</dt><dd>{project.challenge}</dd></div><div><dt>Qué hice</dt><dd>{project.work}</dd></div><div><dt>El resultado</dt><dd>{project.result}</dd></div></dl><div class="tags">{project.tools.map(tool=><span>{tool}</span>)}</div>
            {project.review && <blockquote class="project-review"><p>“{project.review.quote}”</p><cite>{project.review.author} · {project.review.role}</cite></blockquote>}
            <a class="text-link project-source" href={project.url} target="_blank" rel="noopener noreferrer">{project.linkLabel} <ActionMark symbol="+" /></a>
          </article>)}
          <article class:list={["next-project", { "next-project-wide": projects.length % 2 === 0 }]} data-reveal><span class="small-label">UNA INVITACIÓN A COLABORAR</span><span class="next-art" aria-hidden="true"><span>{'{'}</span><Icon name="spark" /><span>{'}'}</span></span><div><h3>¿Será este el<br /><span class="heading-accent">próximo proyecto?</span></h3><p>Estoy buscando colaborar con pequeños negocios que quieran mejorar su presencia online.</p><a class="button button-accent" href="#contacto">Cuéntame tu idea <ActionMark symbol="+" /></a></div></article>
        </div>
        {reviews.length > 0 && <div class="reviews" id="resenas" data-reveal><div><span class="eyebrow">RESEÑAS / LA OTRA PARTE DEL PROYECTO</span><h3>El trabajo también<br />se cuenta <span class="heading-accent">desde el otro lado.</span></h3></div><div class="review-content"><span class="quote-mark" aria-hidden="true">“</span><p>Cada proyecto tiene su historia. Las opiniones de quienes han trabajado conmigo aparecen junto a su web.</p><a class="text-link" href="#proyectos">Leer las reseñas de los proyectos <ActionMark symbol="··" /></a></div></div>}
      </div>
    </section>

    <section class="section services-section" id="desarrollo-web" aria-labelledby="services-title">
      <div class="container">
        <div class="section-top" data-reveal><span class="eyebrow">02 / CÓMO TRABAJO</span><span class="section-note">Una web. Un propósito.</span></div>
        <div class="service-intro" data-reveal><h2 id="services-title">Lo que haces merece<br />verse <span class="heading-accent">bien.</span></h2><p>Una primera web para empezar a estar presente. Un rediseño para que tu negocio deje de parecer de otra época. En ambos casos, el punto de partida eres tú.</p></div>
        <div class="service-paths">
          <article data-reveal><span class="path-icon" aria-hidden="true"><Icon name="plus" /></span><h3>Empezar desde cero.</h3><p>Tu negocio ya tiene una historia. La convierto en una web con tus servicios, tu personalidad y una forma clara de contactar.</p><ul class="service-includes"><li>Estrategia y estructura</li><li>Diseño visual</li><li>Desarrollo adaptado a móvil</li><li>Publicación y puesta a punto</li></ul><span class="small-label">PARA NEGOCIOS SIN WEB</span></article>
          <article data-reveal><span class="path-icon" aria-hidden="true"><Icon name="layers" /></span><h3>Volver a presentarte.</h3><p>Replanteamos una web anticuada: contenido más claro, un diseño actual y una experiencia que funcione también desde el móvil.</p><ul class="service-includes"><li>Auditoría de la web actual</li><li>Nueva jerarquía de contenidos</li><li>Rediseño visual</li><li>Mejora de la experiencia móvil</li></ul><span class="small-label">PARA WEBS QUE NECESITAN UN CAMBIO</span></article>
        </div>
        <div class="process-layout"><div class="process-heading" data-reveal><span class="eyebrow">MI FORMA DE TRABAJAR</span><h3>Contigo.<br /> Paso a paso.</h3><p>Primero hablamos, después te enseño un ejemplo y lo vamos ajustando juntos.</p></div><div class="process-list">{process.map((step,index)=><details class="process-step" open={index===0} data-reveal><summary><span class="small-label">{step.label}</span><span class="step-title">{step.title}</span><Icon name="plus" /></summary><p>{step.description}</p></details>)}</div></div>

      </div>
    </section>

    <section class="section tools-section dark-section" id="herramientas" aria-labelledby="tools-title">
      <div class="container">
        <div class="section-top" data-reveal><span class="eyebrow">03 / HERRAMIENTAS</span><Icon name="code" /></div>
        <div class="section-heading" data-reveal><h2 id="tools-title">Lo que hay<br /><span class="heading-accent">detrás.</span></h2><p>Elijo las herramientas por lo que aportan al proyecto: claridad, rendimiento y una base que pueda seguir creciendo.</p></div>
        <div class="tool-list">{toolkit.map(group=><article class="tool-row" data-reveal><span class="tool-number">{group.number}</span><div><h3>{group.title}</h3><p>{group.summary}</p></div><div class="tool-detail"><ul class="tool-brands" aria-label={`Herramientas de ${group.title.toLowerCase()}`}>
          {group.tools.map(tool => <li class="tool-brand"><span class="tool-logo">{tool.logo ? <img src={tool.logo} alt="" width="28" height="28" loading="lazy" decoding="async" /> : tool.icon && <Icon name={tool.icon} />}</span><span>{tool.name}</span></li>)}
        </ul><p>{group.description}</p></div></article>)}</div>
        <div class="quality-note" data-reveal><span class="small-cross" aria-hidden="true">✳</span><p>La tecnología está para que todo funcione.<br /><strong>La experiencia está para que se note.</strong></p></div>
      </div>
    </section>

    <ContactDetails />
  </main>
  <footer class="footer"><div class="container footer-inner"><a class="brand" href="#inicio">manuel sanchez<span aria-hidden="true">_</span></a><span>© {new Date().getFullYear()} · Siempre aprendiendo.</span><a class="text-link" href="#inicio">Volver arriba <ActionMark symbol="00" /></a></div></footer>
  <script>import '../scripts/interactions';</script>
</Layout>
