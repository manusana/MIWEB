---
import '../styles/global.css';
const title = 'Manuel Sanchez — Portfolio y desarrollo web';
const description = 'Portfolio de Manuel Sanchez, estudiante de Ingeniería Informática. Proyectos, tecnologías y desarrollo web para empresas sin página web o que necesitan renovarla.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
